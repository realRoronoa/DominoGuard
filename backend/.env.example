# DominoGuard Backend Environment Configuration
PORT=4000

# Comma-separated exact origins allowed to call the API, e.g.
# "https://main.d1abc2def.amplifyapp.com,http://localhost:3000".
# Leave empty for local development; set it in production so the API is not
# callable from arbitrary pages.
ALLOWED_ORIGINS=

# -------------------------------------------------------------
# 1. AWS Bedrock Foundation Model (Claude 3 Haiku)
# -------------------------------------------------------------
# If USE_BEDROCK is false, or credentials are missing, or the model call
# fails, every agent falls back to its deterministic path. The response is
# still complete and correct — agentTrace reports which mode each stage used.
AWS_REGION=us-east-1
USE_BEDROCK=true
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Per-call ceiling for a single Bedrock invocation. Three agents run in
# sequence, so keep this well under any upstream gateway timeout.
BEDROCK_TIMEOUT_MS=8000

# (Optional) AWS IAM Access Keys with bedrock:InvokeModel permission.
# On App Runner / EC2, prefer an instance role and leave these blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -------------------------------------------------------------
# 2. Free Live OSINT Data Breach Lookup (Zero-Key)
# -------------------------------------------------------------
# Uses the XposedOrNot public database to check whether an email has
# appeared in historical disclosures (Adobe, LinkedIn, etc). No API key,
# no sign-up. If the lookup fails or times out the result is reported as
# unavailable — never as "clean", which would be a false all-clear.
THREAT_INTEL_ENABLED=true
XPOSEDORNOT_API_URL=https://api.xposedornot.com/v1/check-email
THREAT_INTEL_TIMEOUT_MS=3500

# -------------------------------------------------------------
# 3. Rate limiting
# -------------------------------------------------------------
# Each /simulate call fans out to paid Bedrock invocations plus a
# third-party lookup, so the endpoint is limited per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
