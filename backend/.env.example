# DominoGuard Backend Environment Configuration
PORT=4000

# -------------------------------------------------------------
# 1. AWS Bedrock Foundation Model (Claude 3.5 Haiku)
# -------------------------------------------------------------
# Consume your AWS credits for real-time generative reasoning.
# If keys are omitted, DominoGuard automatically runs in safe
# deterministic fallback mode (zero latency, zero crash guarantee).
AWS_REGION=us-east-1
USE_BEDROCK=true
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# (Optional) AWS IAM Access Keys with Bedrock invokeModel permission:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -------------------------------------------------------------
# 2. Free Live OSINT Cyber Threat & Data Breach API (Zero-Key)
# -------------------------------------------------------------
# Uses XposedOrNot public threat database to verify whether the
# target email has appeared in historical leaks (Adobe, LinkedIn, etc.)
# 100% Free, Zero API Key required, no sign-up needed.
THREAT_INTEL_ENABLED=true
XPOSEDORNOT_API_URL=https://api.xposedornot.com/v1/check-email
